N = 4

board = [[0]*N for _ in range(N)]

# Check if safe to place queen
def is_safe(board, row, col):
    # Check column
    for i in range(row):
        if board[i][col] == 1:
            return False
    
    # Check left diagonal
    i, j = row-1, col-1
    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1; j -= 1
    
    # Check right diagonal
    i, j = row-1, col+1
    while i >= 0 and j < N:
        if board[i][j] == 1:
            return False
        i -= 1; j += 1
    
    return True

# Backtracking function
def solve(board, row):
    if row == N:
        for r in board:
            print(r)
        print()
        return
    
    for col in range(N):
        if is_safe(board, row, col):
            board[row][col] = 1
            solve(board, row+1)
            board[row][col] = 0   # backtrack

# Run
solve(board, 0)
