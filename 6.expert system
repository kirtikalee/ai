def diagnose():
    print("Welcome to Hospital Expert System")
    print("Answer with yes/no\n")

    fever = input("Do you have fever? ").lower()
    cough = input("Do you have cough? ").lower()
    headache = input("Do you have headache? ").lower()
    chest_pain = input("Do you have chest pain? ").lower()

    if fever == "yes" and cough == "yes":
        print("\nPossible Disease: Flu")
        print("Advice: Take rest and consult doctor")

    elif fever == "yes" and headache == "yes":
        print("\nPossible Disease: Viral Infection")
        print("Advice: Drink fluids and take medication")

    elif chest_pain == "yes":
        print("\nPossible Disease: Heart Problem")
        print("Advice: Seek immediate medical attention!")

    else:
        print("\nCondition unclear")
        print("Advice: Please consult a doctor")

# Run system
diagnose()
